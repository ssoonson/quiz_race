{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[0-9][0-9][0-9][0-9]$/) && newData.child('host').isString()",
        "host": { ".validate": "newData.val() === auth.uid || data.val() === newData.val()" },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms').child($code).child('state/phase').val() === 'lobby')",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) || !newData.exists()",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "round": { ".validate": "newData.isNumber()" },
            "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (!data.exists() || newData.val() <= data.val() + 1 || root.child('rooms').child($code).child('host').val() === auth.uid)" },
            "wrong": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "answered": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "lastCorrectAt": { ".validate": "newData.isNumber()" },
            "stunUntil": { ".validate": "newData.isNumber()" },
            "finishedAt": { ".validate": "newData.isNumber() && newData.val() === now && ((root.child('rooms').child($code).child('settings/mode').val() === 'run' && now - root.child('rooms').child($code).child('state/startAt').val() >= root.child('rooms').child($code).child('settings/minFinishMs').val() && newData.parent().child('pos/z').val() <= root.child('rooms').child($code).child('settings/finishZ').val() + 3) || (root.child('rooms').child($code).child('settings/mode').val() !== 'run' && newData.parent().child('correct').val() >= root.child('rooms').child($code).child('settings/goal').val()))" },
            "pos": {
              ".validate": "newData.hasChildren(['x', 'z', 't'])",
              "t": { ".validate": "newData.val() === now" },
              "x": { ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 20" },
              "z": { ".validate": "newData.isNumber() && newData.val() >= -300 && newData.val() <= 60 && (newData.val() >= 20 || 26 - newData.val() <= root.child('rooms').child($code).child('settings/maxSpeed').val() * 1.1 * (now - root.child('rooms').child($code).child('state/startAt').val()) / 1000 + 5)" },
              "j": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
              "st": { ".validate": "newData.isNumber()" },
              "round": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
